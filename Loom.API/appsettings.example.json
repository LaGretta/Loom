{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=LoomDb;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_32_CHAR_SECRET_KEY",
    "Issuer": "LoomApi",
    "Audience": "LoomClient",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}