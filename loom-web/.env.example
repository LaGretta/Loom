# Base URL for the backend API + SignalR hub.
# Leave EMPTY to use same-origin (recommended): the Vite dev proxy and the nginx
# container both forward /api and /hubs to the ASP.NET Core backend, so no CORS is
# required (the backend does not configure CORS).
VITE_API_BASE_URL=

# Dev-only: where `vite` should proxy /api and /hubs to. Defaults to http://localhost:5036.
VITE_DEV_API_TARGET=http://localhost:5036
